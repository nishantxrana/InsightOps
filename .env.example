# ============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================
# This file is used by docker-compose.yml for containerized deployment

# ============================================
# APPLICATION CONFIGURATION (REQUIRED)
# ============================================
# Port to expose the application on
PORT=8000

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/InsightOps?retryWrites=true&w=majority&appName=Cluster0

# ============================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================
# All secrets = exactly 64 hex characters. Same generate command for each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ============================================
# CORS CONFIGURATION (REQUIRED)
# ============================================
# Allowed origins for CORS (comma-separated)
# For production, set to your actual domain
ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com

# ============================================
# EMAIL SERVICE (REQUIRED FOR AUTH OTPs — set BOTH or omit BOTH)
# ============================================
# Azure Communication Services Email
# Connection string: acs-teamtracker-prd → Keys
ACS_CONNECTION_STRING=endpoint=https://acs-teamtracker-prd.communication.azure.com/;accesskey=YOUR_ACCESS_KEY
# MailFrom: acs-subdomain-email → AzureManagedDomain → MailFrom addresses (bare email only)
ACS_EMAIL_FROM=DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net

# ============================================
# FRONTEND BUILD ARGUMENTS (OPTIONAL)
# ============================================
# These are used during Docker build process
# Demo video URL
VITE_DEMO_VIDEO_URL=https://yourdomain.blob.core.windows.net/videos/demo.mp4