# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# MongoDB connection string - Get from MongoDB Atlas or local instance
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/InsightOps?retryWrites=true&w=majority&appName=Cluster0

# ============================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================
# All secrets = exactly 64 hex characters. Same generate command for each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ============================================
# APPLICATION CONFIGURATION (REQUIRED)
# ============================================
# Node environment: development, staging, production
NODE_ENV=development

# Server port
PORT=3001

# Allowed CORS origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ============================================
# EMAIL SERVICE (REQUIRED FOR AUTH OTPs — set BOTH or omit BOTH)
# ============================================
# Azure Communication Services Email (replaces Brevo)
# Used for: signup verification OTPs, password reset OTPs
#
# Connection string from Communication Service (acs-teamtracker-prd → Keys)
#   Portal: acs-teamtracker-prd → Keys → Connection string
#   CLI: az communication list-key --name acs-teamtracker-prd --resource-group <RG>
ACS_CONNECTION_STRING=endpoint=https://acs-teamtracker-prd.communication.azure.com/;accesskey=YOUR_ACCESS_KEY
#
# MailFrom from Email Communication Service domain (acs-subdomain-email → AzureManagedDomain)
#   Portal: acs-subdomain-email → Provision Domains → AzureManagedDomain → MailFrom addresses
#   Ensure the domain is linked on acs-teamtracker-prd → Email → Domains
#   Must be a bare email (no display name)
ACS_EMAIL_FROM=DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net
